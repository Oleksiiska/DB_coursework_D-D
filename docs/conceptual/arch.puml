' ------------------------------------------------------------
'  Рисунок 3.3. CQRS: шлях команд і шлях запитів
' ------------------------------------------------------------
@startuml arch-03-cqrs
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 150
skinparam componentStyle rectangle
skinparam defaultFontSize 12

package "ШЛЯХ КОМАНД (write)" #F8F4EC {
  component "IngestDocument\nHandler" as W1
  component "Валідація\nта трансформації" as W2
  component "Обчислення\nключа розподілу" as W3
  component "Пакетний запис" as W4
}

package "ШЛЯХ ЗАПИТІВ (read)" #F2EEF6 {
  component "SearchAdventures\nHandler" as R1
  component "Нормалізація\nзапиту" as R2
  component "Читання картки\nза ключем" as R3
  component "Обхід графа" as R4
}

database "Документне\nсховище" as DB1
database "Пошуковий\nіндекс" as DB2
database "Граф" as DB3
database "Кеш" as DB4

W1 --> W2
W2 --> W3
W3 --> W4
W4 --> DB1
W4 --> DB2
W4 --> DB3

R1 --> R2
R2 --> DB4 : спершу кеш
R2 --> DB2 : промах
R3 --> DB1
R4 --> DB3
R1 ..> DB4 : запис результату

note bottom
  Моделі різні: команда працює
  з повним документом, запит —
  зі зрізом під конкретну видачу
