' ============================================================
'  Архітектура застосунку: Layered + Hexagonal + CQRS
'  Концептуальні схеми розділу 3 (станом на 28.09.2026):
'  рисунки 3.1–3.4, 3.11, 3.12.
'  Схеми модулів і класів (рисунки 3.5–3.10) будуються з коду:
'    python tools/arch_diagrams.py --out docs/diagrams --plantuml plantuml.jar
'  Рендеринг: java -jar plantuml.jar -tpng -charset UTF-8 arch.puml
' ============================================================

' ------------------------------------------------------------
'  Рисунок 3.1. Шарова архітектура: напрямок залежностей
' ------------------------------------------------------------
@startuml arch-01-layers
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 150
skinparam componentStyle rectangle
skinparam defaultFontSize 12
skinparam nodesep 30
skinparam ranksep 45

package "1. Presentation — подання" #F8F4EC {
  component "Статичний фронтенд" as C3
  component "REST-контролери" as C1
  component "SSE-потік статистики" as C2
}

package "2. Application — сценарії" #F2EEF6 {
  component "Вхідні порти" as C8a
  component "Команди (Command)" as C4
  component "Запити (Query)" as C5
  component "Об'єкти передачі даних" as C6
}

package "3. Domain — предметна область" as DOM #EDF4F2 {
  component "Доменні служби" as C9
  component "Вихідні порти" as C8
  component "Сутності та значення" as C7
}

package "4. Infrastructure — інфраструктура" #F4F4F4 {
  component "Адаптери сховищ" as C10
  component "Адаптери джерел" as C11
  component "Черга повідомлень,\nжурнал якості даних" as C12
}

C3 -right-> C1 : HTTP
C1 --> C8a
C2 --> C8a
C8a <|.. C4 : реалізують
C8a <|.. C5
C8a -right-> C6
C4 --> C8
C5 --> C8
C4 --> C9
C5 --> C7
C8 <|.. C10 : реалізують
C8 <|.. C11
C8 <|.. C12

note right of DOM
  Домен не залежить ні від чого:
  ані від бази, ані від фреймворку.
  Інфраструктура залежить від домену
  (стрілки реалізації спрямовані вгору)
end note

@enduml


