' ------------------------------------------------------------
'  Рисунок 3.11. Обробка пошукового запиту
' ------------------------------------------------------------
@startuml arch-06-sequence-read
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 12
hide footbox

actor Користувач as U
participant "SearchController" as C
participant "SearchAdventuresHandler\n<size:10>(шаблон CachedSearchHandler)</size>" as H
participant "QueryNormalizer" as N
participant "CacheStore" as K
participant "SearchIndex" as S
participant "CrudRepository\n<size:10>[Adventure]</size>" as D
participant "MetricsSink" as M

U -> C : GET /api/search/adventures?q=...
C -> H : handle(SearchQueryDTO)
H -> H : перевірка типу фільтрів
H -> N : cache_key(kind, raw, spec)
N --> H : ключ кешу

H -> K : get(key)
alt влучання в кеш
  K --> H : готовий результат
else промах
  K --> H : порожньо
  H -> S : search(text, spec, page, sort)
  S --> H : SearchHits: ідентифікатори й фрагменти
  H -> D : get_many(ids)
  D --> H : сутності в порядку видачі
  H -> H : _to_card() для кожної сутності
  H -> K : set(key, result, ttl)
end
H -> M : record_query(SearchLogEntry)
H --> C : SearchResultDTO
C --> U : JSON

@enduml


' ------------------------------------------------------------
'  Рисунок 3.12. Запис документа від джерела до сховищ
' ------------------------------------------------------------
@startuml arch-07-sequence-write
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 12
hide footbox

participant "Процес-джерело\n<size:10>CsvLoader, GeneratorWorker,</size>\n<size:10>CrawlerWorker</size>" as SRC
queue "Черга" as Q
participant "IngestWorker" as W
participant "IngestDocumentHandler" as H
participant "Доменні служби\n<size:10>DocumentValidator,</size>\n<size:10>ShardKeyService</size>" as DS
participant "Сховища\n<size:10>через вихідні порти</size>" as ST
participant "DataQualityLog" as QL
participant "MetricsSink" as M

SRC -> SRC : пакет із stream()\n<size:10>DocumentSource</size>
SRC -> Q : publish(topic, batch)\n<size:10>EventPublisher</size>
W -> Q : consume(topic)\n<size:10>EventConsumer</size>
Q --> W : QueuedBatch\n<size:10>batch_id і документи</size>
W -> H : handle(documents, source)
H -> H : групування\nза DocumentKind
loop для кожного документа
  H -> DS : check(kind, doc)
  alt документ валідний
    DS --> H : порушень немає
    H -> H : трансформації,\nобчислювані поля
    H -> DS : shard_key(doc_id)
    DS --> H : ключ розподілу
  else брак
    DS --> H : перелік порушень
    H -> QL : rejected(doc, reasons)
  end
end
note over H, ST : пакетний паралельний запис у три сховища
H -> ST : CrudRepository.add_many(валідні)
H -> ST : SearchIndex.index_many(валідні)\n<size:10>лише пригоди, монстри, зустрічі</size>
H -> ST : GraphRepository\n.merge_nodes_and_edges(валідні)
H -> M : inc(saved), inc(rejected)
H --> W : IngestReport
W -> Q : acknowledge(topic, batch_id)

@enduml
